# ==========================================
# INFRASTRUCTURE GOVERNANCE — INTEGRATED IA CLAUDE
# ==========================================
FROM node:24.11.1-slim

# 1. Instalar dependencias del sistema mínimas e instalar Git (Requisito mínimo del protocolo de análisis)
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

# 2. Configurar el entorno de ejecución seguro (No-Root = eboe62)
# Alineación de identidad (Mapear 'node' a 'eboe62')
# Modificamos el usuario existente 'node' (UID 1000) para que se llame 'eboe62'
RUN usermod -l eboe62 node && \
    usermod -d /home/eboe62 -m eboe62 && \
    groupmod -n eboe62 node

# 3. CAMBIO DE USUARIO SEGURO
USER eboe62
WORKDIR /workspace

# 4. Configurar NPM para instalar en el home de eboe62 (Evita errores de permisos)
ENV NPM_CONFIG_PREFIX=/home/eboe62/.npm-global
ENV PATH=$PATH:/home/eboe62/.npm-global/bin

# 5. Instalación global de Claude Code DENTRO del contenedor en el espacio del usuario
RUN npm install -g @anthropic-ai/claude-code

# Desactivar telemetrías o variables que puedan forzar fugas (ajustable según el cliente)
ENV CI=true

CMD ["/bin/bash"]
