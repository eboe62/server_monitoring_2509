# === Archivos sensibles de SMTP Relay ===
ops/services/smtp_relay/secrets/*
!ops/services/smtp_relay/secrets/.gitkeep
ops/services/smtp_relay/config/sasl_passwd
ops/services/smtp_relay/config/sasl_passwd.db
ops/services/**/secrets/*
**/secrets/**
!**/secrets/.gitkeep

# === Entornos virtuales Python ===
src/log_ingestor/venv/
**/venv/
*.pyc
__pycache__/

# === Logs ===
*.log
/var/log/*
resources/logs/*.log
resources/logs/*.txt

# === Archivos temporales / swap ===
*.swp
*.swo
*~
.DS_Store

# === Docker ===
*.pid
*.sock
.env
.env.*
docker-compose.override.yml

# Permitir templates necesarios para CI
!.env.template
!**/.env.template

# === Otros ===
/*.bak
*.tmp

# === Informes generados por make audit-runtime* (ADR-0030/0031) ===
/artifacts/

# === Gobernanza y documentación IA (ADR-0035): repositorios independientes ===
# ai/   = governance_ia_2607       docs/ = governance_ia_docs_2609
# Puntos de entrada: enlaces creados por make ai-setup, no versionados.
ai/
docs/
CLAUDE.md
AI_ENTRYPOINT.md
.github/copilot-instructions.md
.claudecodeignore
.ua

# === Documentation working copies ===
* copy*

# === Temporary files or files marked for deletion ===
*_BORRAR*

# === Backups de base de datos ===
/backups/
/backups_old/
*.backup
*.bak
*.dump
*.sql
# Excepción: esquema declarativo de Postgres (FASE 6). Debe ir después de *.sql
!ops/services/postgres/init/*.sql

# === Certificados ===
*.pem
*.key
*.p12
*.crt

# === Documentation Podcast, Slides, etc ===
*.m4a
*.pdf
*.xlsx
*.xls
*.pptx
*.ppt
