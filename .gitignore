# === Archivos sensibles de SMTP Relay ===
ops/services/smtp_relay/secrets/*
!ops/services/smtp_relay/secrets/.gitkeep
ops/services/smtp_relay/config/sasl_passwd
ops/services/smtp_relay/config/sasl_passwd.db
ops/services/**/secrets/*
**/secrets/**
!**/secrets/.gitkeep

# === Entornos virtuales Python ===
src/log_ingestor/venv/
**/venv/
*.pyc
__pycache__/

# === Logs ===
*.log
/var/log/*
resources/logs/*.log
resources/logs/*.txt

# === Archivos temporales / swap ===
*.swp
*.swo
*~
.DS_Store

# === Docker ===
*.pid
*.sock
.env
.env.*
docker-compose.override.yml

# Permitir templates necesarios para CI
!.env.template
!**/.env.template

# === Otros ===
/*.bak
*.tmp

# === AI Governance (must be versioned independently) ===
ai/

# === Understand-Anything Governance ===
# Permitir la persistencia del enlace simbólico, el grafo y la carpeta de datos
!.ua
!docs/arquitectura/.ua/knowledge-graph.json
!docs/arquitectura/.ua/config.json
!docs/arquitectura/.ua/.understandignore

# === Understand-Anything ignorar estrictamente los datos temporales y de procesamiento local ===
docs/arquitectura/.ua/intermediate/
docs/arquitectura/.ua/tmp/
docs/arquitectura/.ua/diff-overlay.json
docs/arquitectura/.ua/.trash-*/

# === Documentation working copies ===
* copy*

# === Backups de base de datos ===
/backups/
/backups_old/
*.backup
*.bak
*.dump
*.sql

# === Certificados ===
*.pem
*.key
*.p12
*.crt

# === Documentation Podcast, Slides, etc ===
docs/Project_ADRs/*
docs/Project_Corrections/*
*.m4a
*.pdf
*.xlsx
*.xls
*.pptx
*.ppt
