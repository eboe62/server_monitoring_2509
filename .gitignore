# === Archivos sensibles de SMTP Relay ===
ops/services/smtp_relay/secrets/*
!ops/services/smtp_relay/secrets/.gitkeep
ops/services/smtp_relay/config/sasl_passwd
ops/services/smtp_relay/config/sasl_passwd.db
ops/services/**/secrets/*
**/secrets/**
!**/secrets/.gitkeep

# === Entornos virtuales Python ===
src/log_ingestor/venv/
**/venv/
*.pyc
__pycache__/

# === Logs ===
*.log
/var/log/*
resources/logs/*.log
resources/logs/*.txt

# === Archivos temporales / swap ===
*.swp
*.swo
*~
.DS_Store

# === Docker ===
*.pid
*.sock
.env
.env.*
docker-compose.override.yml

# Permitir templates necesarios para CI
!.env.template
!**/.env.template

# === Otros ===
/*.bak
*.tmp

# === AI Governance (must be versioned independently) ===
ai/*.*

# === Understand-Anything: Conservar el Grafo y la Configuración ===
!.ua/

# === Understand-Anything datos temporales (must be versioned independently) ===
.ua/intermediate/
.ua/tmp/
.ua/diff-overlay.json

# === Documentation working copies ===
* copy*

# === Backups de base de datos ===
/backups/
/backups_old/
*.backup
*.bak
*.dump
*.sql

# === Certificados ===
*.pem
*.key
*.p12
*.crt

# === Documentation Podcast, Slides, etc ===
docs/Project_ADRs/*
docs/Project_Corrections/*
*.m4a
*.pdf
*.xlsx
*.xls
*.pptx
*.ppt
