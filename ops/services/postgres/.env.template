# ------------------------------------------
# PostgreSQL CONFIG (DOCKER)
# ------------------------------------------

POSTGRES_CONTAINER_NAME=monitoring-postgres
# POSTGRES_HOST="localhost"  # Si estás ejecutando en el mismo contenedor o servidor
# POSTGRES_HOST=xxx-xxxxxx--xxxxxxxx999999xxx # Si estás ejecutando en remoto
POSTGRES_HOST=xxxxxxxxxx-xxxxxxx
POSTGRES_PORT=9992

POSTGRES_NAME=monitoring_db
# POSTGRES_NAME=xxxxxxxx9999
POSTGRES_USER=xxxxxxxx

# La contraseña de PostgreSQL se gestiona mediante un secreto en el sistema de ficheros.
#
# En tiempo de ejecución dentro de contenedores:
#   POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
#
# Ejemplo de origen del secreto en el host:
#   ops/services/postgres/secrets/postgres_password
#
# Ejemplo de montaje en Docker Compose:
#   ./secrets/postgres_password:/run/secrets/postgres_password:ro
#
# NUNCA almacene POSTGRES_PASSWORD directamente en este fichero.
# Para permitir que scripts en host/CI puedan acceder al secreto fuera
# del contenedor, puede definir `POSTGRES_PASSWORD_FILE` apuntando al path
# en el host, por ejemplo:
#   POSTGRES_PASSWORD_FILE=ops/services/postgres/secrets/postgres_password
# No obstante, la ruta canónica en tiempo de ejecución dentro del contenedor es:
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# ------------------------------------------
# APP CONFIG
# ------------------------------------------

MONITORING_ROOT=/opt/monitoring
BACKUP_DIR_HOST=/opt/monitoring/ops/backups
