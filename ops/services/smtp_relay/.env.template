# Configuración de SMTP Relay (Postfix)

SMTP_RELAY_CONTAINER_NAME=monitoring-smtp-relay
SMTP_RELAY_ENV_PATH="ops/services/smtp_relay/.env"
# Para utilizar Postfix como servicio systemctl directamente desde el host
# SMTP_SERVER=xxxx.xxxxxxxxxxx.xxx
# SMTP_PORT=9999

# Para utilizar Postfix como servicio systemctl directamente desde el host
# Para utilizar Postfix a través del contenedor smtp-relay que gestiona Postfix
# Configuración SMTP común
SMTP_SERVER=smtp.test.local
SMTP_PORT=587

# Postmark SMTP credentials
EMAIL_USER=99x9xx99-9x99-9x99-99x9-99xx9xxx9xxx
EMAIL_PASS=99x9xx99-9x99-9x99-99x9-99xx9xxx9xxx
EMAIL_FROM=xxxxxxx@xxxxxxxxxxxxx.xx
EMAIL_DOMAIN=xxxxxxxxxxxxx.xx
EMAIL_TO=test.local

# Redes permitidas para relay
MYNETWORKS=999.9.9.9/9 999.99.9.9/99 [::9]999

# IP Geolocalización https://ipinfo.io/
IPINFO_TOKEN="9999x9x9xx999"
