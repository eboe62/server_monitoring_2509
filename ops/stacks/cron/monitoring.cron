# Auditoria de Binarios (con log propio)
0 11 * * * python3 -m log_ingestor.auditoria_binarios

# Recursos Docker cada hora
# */10 * * * * python3 -m resource_monitor.docker_resources PRE-MIGRACION (BORRAR)
*/10 * * * * echo "[CRON][docker_resources][START]" && python3 -m resource_monitor.docker_resources

# Jobs de log_ingestor (cada 10 min)
*/10 * * * * python3 -m log_ingestor.log_ingest_batch
*/10 * * * * python3 -m log_ingestor.log_fail2ban_batch
*/10 * * * * python3 -m log_ingestor.log_kern_batch
*/10 * * * * python3 -m log_ingestor.log_ip_geolocation
*/10 * * * * python3 -m log_ingestor.log_honeypot_geolocation

# Alertas de riesgo a las 10h y 22h
0 10,22 * * * python3 -m log_ingestor.alert_risk

# Prueba de alertas (cada minuto, solo si se necesita debug)
# * * * * * python3 -m log_ingestor.alert_risk
# * * * * * python3 -m resource_monitor.docker_resources >> /var/log/docker_resources.log 2>&1
# * * * * * python3 -m log_ingestor.log_ingest_batch

# Backup de BBDD monitoring-postgres
5 22 * * * python3 ops/services/postgres/scripts/backup_postgres.py
