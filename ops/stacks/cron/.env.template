# Configuración del contenedor monitoring-cron (Línea A)
#
# Plantilla didáctica: copiar a ops/stacks/cron/.env (no versionado) y sustituir los valores.
#    cp ops/stacks/cron/.env.template ops/stacks/cron/.env
#    chmod 600 ops/stacks/cron/.env
#
# Este fichero NO contiene contraseñas:
# - La contraseña de PostgreSQL llega como fichero (POSTGRES_PASSWORD_FILE, ver compose.yml).
# - Las credenciales de Postmark solo las tiene smtp-relay; cron le entrega el correo sin autenticarse.
# La conexión a la BBDD (host, puerto, nombre, usuario) se toma de ops/services/postgres/.env.

# ------------------------------------------
# Envío de correo a través del contenedor smtp-relay (red restricted-net)
# ------------------------------------------
# Nombre del contenedor smtp-relay (SMTP_RELAY_CONTAINER_NAME en ops/services/smtp_relay/.env)
# (no es un dato sensible: es el nombre DNS del contenedor en la red Docker)
SMTP_SERVER=monitoring-smtp-relay
# Puerto en el que escucha Postfix dentro del contenedor smtp-relay
SMTP_PORT=587

# Remitente: debe pertenecer al dominio permitido por el relay (EMAIL_DOMAIN)
EMAIL_FROM=xxxxxxx@xxxxxxxxxxxxx.xx
# Destinatario principal de las alertas
EMAIL_TO=xxxxxxx@xxxxxxxxxxxxx.xx
# Copias, separadas por comas (opcional; vacío = sin copia)
CC_LIST=

# ------------------------------------------
# IP Geolocalización https://ipinfo.io/ (log_ip_geolocation)
# ------------------------------------------
IPINFO_TOKEN="9999x9x9xx999"
