# ---- Stage 1: descargar supercronic ----
FROM debian:stable-slim AS supercronic-downloader

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && curl -L https://github.com/aptible/supercronic/releases/download/v0.2.29/supercronic-linux-amd64 \
    -o /supercronic \
 && chmod +x /supercronic \
 && rm -rf /var/lib/apt/lists/*

# ---- Stage 2: imagen final ----
FROM monitoring-base

# Instalar utilidades necesarias
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    bc \
 && rm -rf /var/lib/apt/lists/*

# Copiar supercronic desde stage anterior
COPY --from=supercronic-downloader /supercronic /usr/local/bin/supercronic

# Copiar entrypoint
COPY ops/docker/docker-entrypoint.cron.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV PYTHONPATH=/opt/monitoring/src

WORKDIR /opt/monitoring

# Healthcheck para detectar fallo de cron
HEALTHCHECK CMD pgrep supercronic || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
